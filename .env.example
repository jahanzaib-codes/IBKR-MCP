# ==============================================================================
# IBKR-MCP Configuration
# Model Context Protocol Server for Interactive Brokers (TWS & IB Gateway)
# ==============================================================================

# Interactive Brokers TWS / Gateway Connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497               # 7497 = TWS Paper, 7496 = TWS Live, 4002 = Gateway Paper, 4001 = Gateway Live
IBKR_CLIENT_ID=42            # Unique client ID for this MCP agent connection
IBKR_TIMEOUT_SEC=15
IBKR_MOCK_FALLBACK=true      # Set true to simulate responses if TWS is offline or market is closed

# Safety & Execution Guardrails (Human-in-the-Loop)
IBKR_READ_ONLY=true          # If true, blocks any order placement, cancel, or modification
MAX_ORDER_VALUE_USD=10000.0  # Hard ceiling on maximum single trade preview/order value
ALLOW_LIVE_TRADING=false     # Enforce paper trading only unless explicitly unlocked
REQUIRE_EXPLICIT_CONFIRM=true # Demands confirm=True flag for any mutation

# MCP Server Transport Settings
MCP_TRANSPORT=stdio          # stdio or sse
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8000

